    <visual>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint3.dae"/>
      </geometry>
      <origin rpy="0 -1.5708 0" xyz="0.0 0 0.03256"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint3.dae"/>
      </geometry>
      <origin rpy="0 -1.5708 0" xyz="0.0 0 0.03256"/>
    </collision>
    <inertial>
      <mass value="0.10"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.00008" ixy="0" ixz="0" iyy="0.00008" iyz="0" izz="0.00004"/>
    </inertial>
  </link>
  <link name="joint4">
    <visual>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint4.dae"/>
      </geometry>
      <origin rpy="0 -1.5708 0" xyz="0.0 0 0.03056"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint4.dae"/>
      </geometry>
      <origin rpy="0 -1.5708 0" xyz="0.0 0 0.03056"/>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.00006" ixy="0" ixz="0" iyy="0.00006" iyz="0" izz="0.00003"/>
    </inertial>
  </link>
  <link name="joint5">
    <visual>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint5.dae"/>
      </geometry>
      <origin rpy="-1.5708 0 0" xyz="0.0 0 -0.03356"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint5.dae"/>
      </geometry>
      <origin rpy="-1.5708 0 0" xyz="0.0 0 -0.03356"/>
