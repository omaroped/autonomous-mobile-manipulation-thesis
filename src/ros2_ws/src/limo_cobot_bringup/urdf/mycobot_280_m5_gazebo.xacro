<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="mycobot_280_m5_gazebo" params="prefix:=''">

    <!--
    <link name="${prefix}g_base">
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/G_base.dae"/>
        </geometry>
        <origin xyz="0.0 0 -0.03" rpy="0 0 1.5708"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/G_base.dae"/>
        </geometry>
        <origin xyz="0.0 0 -0.03" rpy="0 0 1.5708"/>
      </collision>
      <inertial>
        <mass value="0.2"/>
        <origin xyz="0 0 -0.015" rpy="0 0 1.5708"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>
    -->

    <link name="${prefix}joint1">
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint1.dae"/>
        </geometry>
        <origin xyz="0.0 0 0" rpy="0 0 -1.5708"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint1.dae"/>
        </geometry>
        <origin xyz="0.0 0 0" rpy="0 0 -1.5708"/>
      </collision>
      <inertial>
        <mass value="0.12"/>
        <origin xyz="0 0 0.065" rpy="0 0 0"/>
        <inertia ixx="0.00008" ixy="0" ixz="0" iyy="0.00008" iyz="0" izz="0.00006"/>
      </inertial>
    </link>

    <link name="${prefix}joint2">
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint2.dae"/>
        </geometry>
        <origin xyz="0.0 0 -0.06096" rpy="0 0 -1.5708"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint2.dae"/>
        </geometry>
        <origin xyz="0.0 0 -0.06096" rpy="0 0 -1.5708"/>
      </collision>
      <inertial>
        <mass value="0.12"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <link name="${prefix}joint3">
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint3.dae"/>
        </geometry>
        <origin xyz="0.0 0 0.03256" rpy="0 -1.5708 0"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint3.dae"/>
        </geometry>
        <origin xyz="0.0 0 0.03256" rpy="0 -1.5708 0"/>
      </collision>
      <inertial>
        <mass value="0.10"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.00008" ixy="0" ixz="0" iyy="0.00008" iyz="0" izz="0.00004"/>
      </inertial>
    </link>

    <link name="${prefix}joint4">
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint4.dae"/>
        </geometry>
        <origin xyz="0.0 0 0.03056" rpy="0 -1.5708 0"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint4.dae"/>
        </geometry>
        <origin xyz="0.0 0 0.03056" rpy="0 -1.5708 0"/>
      </collision>
      <inertial>
        <mass value="0.08"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.00006" ixy="0" ixz="0" iyy="0.00006" iyz="0" izz="0.00003"/>
      </inertial>
    </link>

    <link name="${prefix}joint5">
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint5.dae"/>
        </geometry>
        <origin xyz="0.0 0 -0.03356" rpy="-1.5708 0 0"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint5.dae"/>
        </geometry>
        <origin xyz="0.0 0 -0.03356" rpy="-1.5708 0 0"/>
      </collision>
      <inertial>
        <mass value="0.08"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.00004" ixy="0" ixz="0" iyy="0.00004" iyz="0" izz="0.00003"/>
      </inertial>
    </link>

    <link name="${prefix}joint6">
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint6.dae"/>
        </geometry>
        <origin xyz="0 0.00 -0.038" rpy="0 0 0"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint6.dae"/>
        </geometry>
        <origin xyz="0 0.00 -0.038" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
      </inertial>
    </link>

    <link name="${prefix}joint6_flange">
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint7.dae"/>
        </geometry>
        <origin xyz="0.0 0 -0.012" rpy="0 0 0"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/mycobot_280_m5/joint7.dae"/>
        </geometry>
        <origin xyz="0.0 0 -0.012" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
    </link>

    <!--
    <joint name="${prefix}g_base_to_joint1" type="fixed">
      <axis xyz="0 0 0"/>
      <parent link="${prefix}g_base"/>
      <child link="${prefix}joint1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    -->

    <joint name="${prefix}joint2_to_joint1" type="revolute">
      <axis xyz="0 0 1"/>
      <limit effort="5.0" lower="-2.9321" upper="2.9321" velocity="3.14"/>
      <parent link="${prefix}joint1"/>
      <child link="${prefix}joint2"/>
      <origin xyz="0 0 0.13156" rpy="0 0 0"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <joint name="${prefix}joint3_to_joint2" type="revolute">
      <axis xyz="0 0 1"/>
      <limit effort="5.0" lower="-2.4434" upper="2.4434" velocity="3.14"/>
      <parent link="${prefix}joint2"/>
      <child link="${prefix}joint3"/>
      <origin xyz="0 0 0" rpy="0 1.5708 -1.5708"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <joint name="${prefix}joint4_to_joint3" type="revolute">
      <axis xyz="0 0 1"/>
      <limit effort="5.0" lower="-2.6179" upper="2.6179" velocity="3.14"/>
      <parent link="${prefix}joint3"/>
      <child link="${prefix}joint4"/>
      <origin xyz="-0.1104 0 0" rpy="0 0 0"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <joint name="${prefix}joint5_to_joint4" type="revolute">
      <axis xyz="0 0 1"/>
      <limit effort="5.0" lower="-2.6179" upper="2.6179" velocity="3.14"/>
      <parent link="${prefix}joint4"/>
      <child link="${prefix}joint5"/>
      <origin xyz="-0.096 0 0.06462" rpy="0 0 -1.5708"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <joint name="${prefix}joint6_to_joint5" type="revolute">
      <axis xyz="0 0 1"/>
      <limit effort="5.0" lower="-2.7052" upper="2.7925" velocity="3.14"/>
      <parent link="${prefix}joint5"/>
      <child link="${prefix}joint6"/>
      <origin xyz="0 -0.07318 0" rpy="1.5708 -1.5708 0"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <joint name="${prefix}joint6output_to_joint6" type="revolute">
      <axis xyz="0 0 1"/>
      <limit effort="5.0" lower="-3.14159" upper="3.14159" velocity="3.14"/>
      <parent link="${prefix}joint6"/>
      <child link="${prefix}joint6_flange"/>
      <origin xyz="0 0.0456 0" rpy="-1.5708 0 0"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <gazebo reference="${prefix}g_base">
      <material>Gazebo/White</material>
    </gazebo>
    <gazebo reference="${prefix}joint1">
      <material>Gazebo/White</material>
    </gazebo>
    <gazebo reference="${prefix}joint2">
      <material>Gazebo/White</material>
    </gazebo>
    <gazebo reference="${prefix}joint3">
      <material>Gazebo/White</material>
    </gazebo>
    <gazebo reference="${prefix}joint4">
      <material>Gazebo/White</material>
    </gazebo>
    <gazebo reference="${prefix}joint5">
      <material>Gazebo/White</material>
    </gazebo>
    <gazebo reference="${prefix}joint6">
      <material>Gazebo/White</material>
    </gazebo>
    <gazebo reference="${prefix}joint6_flange">
      <material>Gazebo/White</material>
    </gazebo>

    <ros2_control name="mycobot_arm" type="system">
      <hardware>
        <plugin>gazebo_ros2_control/GazeboSystem</plugin>
      </hardware>

      <joint name="${prefix}joint2_to_joint1">
        <command_interface name="position">
          <param name="min">-2.9321</param>
          <param name="max">2.9321</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="${prefix}joint3_to_joint2">
        <command_interface name="position">
          <param name="min">-2.4434</param>
          <param name="max">2.4434</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="${prefix}joint4_to_joint3">
        <command_interface name="position">
          <param name="min">-2.6179</param>
          <param name="max">2.6179</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="${prefix}joint5_to_joint4">
        <command_interface name="position">
          <param name="min">-2.6179</param>
          <param name="max">2.6179</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="${prefix}joint6_to_joint5">
        <command_interface name="position">
          <param name="min">-2.7052</param>
          <param name="max">2.7925</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="${prefix}joint6output_to_joint6">
        <command_interface name="position">
          <param name="min">-3.14159</param>
          <param name="max">3.14159</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <!-- Gripper active joint -->
      <joint name="${prefix}gripper_controller">
        <command_interface name="position">
          <param name="min">-0.74</param>
          <param name="max">0.15</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <!-- Gripper passive/mimic joints (no command interfaces) -->
      <joint name="${prefix}gripper_base_to_gripper_left2">
        <param name="mimic">${prefix}gripper_controller</param>
        <param name="multiplier">1.0</param>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}gripper_left3_to_gripper_left1">
        <param name="mimic">${prefix}gripper_controller</param>
        <param name="multiplier">-1.0</param>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}gripper_base_to_gripper_right3">
        <param name="mimic">${prefix}gripper_controller</param>
        <param name="multiplier">-1.0</param>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}gripper_base_to_gripper_right2">
        <param name="mimic">${prefix}gripper_controller</param>
        <param name="multiplier">-1.0</param>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}gripper_right3_to_gripper_right1">
        <param name="mimic">${prefix}gripper_controller</param>
        <param name="multiplier">1.0</param>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

    <gazebo>
      <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
        <parameters>$(find limo_cobot_bringup)/config/arm_controllers.yaml</parameters>
        <robot_param>robot_description</robot_param>
        <robot_param_node>robot_state_publisher</robot_param_node>
      </plugin>
    </gazebo>

  </xacro:macro>
</robot>
