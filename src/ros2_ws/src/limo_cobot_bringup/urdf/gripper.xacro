<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="adaptive_gripper" params="prefix:='' parent_link">

    <link name="${prefix}gripper_base">
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/meshes/mycobot_280/gripper_base.dae"/>
        </geometry>
        <origin xyz="0.0 0 -0.012" rpy="0 0 0"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://mycobot_description/meshes/mycobot_280/gripper_base.dae"/>
        </geometry>
        <origin xyz="0.0 0 -0.012" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <link name="${prefix}gripper_left1">
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/meshes/mycobot_280/gripper_left1.dae"/>
        </geometry>
        <origin xyz="0.039 -0.0133 -0.012" rpy="0 0 0"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://mycobot_description/meshes/mycobot_280/gripper_left1.dae"/>
        </geometry>
        <origin xyz="0.039 -0.0133 -0.012" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.03"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
      </inertial>
    </link>

    <link name="${prefix}gripper_left2">
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/meshes/mycobot_280/gripper_left2.dae"/>
        </geometry>
        <origin xyz="0.005 -0.0195 -0.012" rpy="0 0 0"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://mycobot_description/meshes/mycobot_280/gripper_left2.dae"/>
        </geometry>
        <origin xyz="0.005 -0.0195 -0.012" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.03"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
      </inertial>
    </link>

    <link name="${prefix}gripper_left3">
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/meshes/mycobot_280/gripper_left3.dae"/>
        </geometry>
        <origin xyz="0.012 0.0025 -0.012" rpy="0 0 0"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://mycobot_description/meshes/mycobot_280/gripper_left3.dae"/>
        </geometry>
        <origin xyz="0.012 0.0025 -0.012" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.03"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
      </inertial>
    </link>

    <link name="${prefix}gripper_right1">
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/meshes/mycobot_280/gripper_right1.dae"/>
        </geometry>
        <origin xyz="-0.039 -0.0133 -0.012" rpy="0 0 0"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://mycobot_description/meshes/mycobot_280/gripper_right1.dae"/>
        </geometry>
        <origin xyz="-0.039 -0.0133 -0.012" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.03"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
      </inertial>
    </link>

    <link name="${prefix}gripper_right2">
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/meshes/mycobot_280/gripper_right2.dae"/>
        </geometry>
        <origin xyz="-0.005 -0.0195 -0.012" rpy="0 0 0"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://mycobot_description/meshes/mycobot_280/gripper_right2.dae"/>
        </geometry>
        <origin xyz="-0.005 -0.0195 -0.012" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.03"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
      </inertial>
    </link>

    <link name="${prefix}gripper_right3">
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/meshes/mycobot_280/gripper_right3.dae"/>
        </geometry>
        <origin xyz="-0.012 0.0025 -0.012" rpy="0 0 0"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://mycobot_description/meshes/mycobot_280/gripper_right3.dae"/>
        </geometry>
        <origin xyz="-0.012 0.0025 -0.012" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.03"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
      </inertial>
    </link>

    <joint name="${prefix}joint6output_to_gripper_base" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${prefix}gripper_base"/>
      <origin xyz="0 0 0.034" rpy="1.579 0 1.5708"/>
    </joint>

    <joint name="${prefix}gripper_tcp_joint" type="fixed">
      <parent link="${prefix}gripper_base"/>
      <child link="${prefix}gripper_tcp"/>
      <origin xyz="0 0.036 0" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}gripper_tcp">
      <inertial>
        <mass value="0.001"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
      </inertial>
    </link>

    <joint name="${prefix}gripper_controller" type="revolute">
      <axis xyz="0 0 1"/>
      <limit effort="10.0" lower="-0.74" upper="0.15" velocity="1.0"/>
      <parent link="${prefix}gripper_base"/>
      <child link="${prefix}gripper_left3"/>
      <origin xyz="-0.012 0.005 0" rpy="0 0 0"/>
    </joint>

    <joint name="${prefix}gripper_base_to_gripper_left2" type="revolute">
      <axis xyz="0 0 1"/>
      <limit effort="10.0" lower="-0.8" upper="0.5" velocity="1.0"/>
      <parent link="${prefix}gripper_base"/>
      <child link="${prefix}gripper_left2"/>
      <origin xyz="-0.005 0.027 0" rpy="0 0 0"/>
      <mimic joint="${prefix}gripper_controller" multiplier="1.0" offset="0"/>
    </joint>

    <joint name="${prefix}gripper_left3_to_gripper_left1" type="revolute">
      <axis xyz="0 0 1"/>
      <limit effort="10.0" lower="-0.5" upper="0.5" velocity="1.0"/>
      <parent link="${prefix}gripper_left3"/>
      <child link="${prefix}gripper_left1"/>
      <origin xyz="-0.027 0.016 0" rpy="0 0 0"/>
      <mimic joint="${prefix}gripper_controller" multiplier="-1.0" offset="0"/>
    </joint>

    <joint name="${prefix}gripper_base_to_gripper_right3" type="revolute">
      <axis xyz="0 0 1"/>
      <limit effort="10.0" lower="-0.15" upper="0.7" velocity="1.0"/>
      <parent link="${prefix}gripper_base"/>
      <child link="${prefix}gripper_right3"/>
      <origin xyz="0.012 0.005 0" rpy="0 0 0"/>
      <mimic joint="${prefix}gripper_controller" multiplier="-1.0" offset="0"/>
    </joint>

    <joint name="${prefix}gripper_base_to_gripper_right2" type="revolute">
      <axis xyz="0 0 1"/>
      <limit effort="10.0" lower="-0.5" upper="0.8" velocity="1.0"/>
      <parent link="${prefix}gripper_base"/>
      <child link="${prefix}gripper_right2"/>
      <origin xyz="0.005 0.027 0" rpy="0 0 0"/>
      <mimic joint="${prefix}gripper_controller" multiplier="-1.0" offset="0"/>
    </joint>

    <joint name="${prefix}gripper_right3_to_gripper_right1" type="revolute">
      <axis xyz="0 0 1"/>
      <limit effort="10.0" lower="-0.5" upper="0.5" velocity="1.0"/>
      <parent link="${prefix}gripper_right3"/>
      <child link="${prefix}gripper_right1"/>
      <origin xyz="0.027 0.016 0" rpy="0 0 0"/>
      <mimic joint="${prefix}gripper_controller" multiplier="1.0" offset="0"/>
    </joint>

    <gazebo reference="${prefix}gripper_base">
      <material>Gazebo/White</material>
    </gazebo>
    <gazebo reference="${prefix}gripper_left1">
      <material>Gazebo/DarkGrey</material>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
    <gazebo reference="${prefix}gripper_left2">
      <material>Gazebo/DarkGrey</material>
    </gazebo>
    <gazebo reference="${prefix}gripper_left3">
      <material>Gazebo/DarkGrey</material>
    </gazebo>
    <gazebo reference="${prefix}gripper_right1">
      <material>Gazebo/DarkGrey</material>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
    <gazebo reference="${prefix}gripper_right2">
      <material>Gazebo/DarkGrey</material>
    </gazebo>
    <gazebo reference="${prefix}gripper_right3">
      <material>Gazebo/DarkGrey</material>
    </gazebo>

  </xacro:macro>
</robot>
