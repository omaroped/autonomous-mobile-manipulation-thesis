<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypesxsd="http://www.w3.org/2001/XMLSchema-instance"?>
<package format="3">
  <name>limo_cobot_bridge</name>
  <version>1.0.0</version>
  <description>Bridge between LIMO base and myCobot arm MTC pick-and-place pipeline</description>
  <maintainer email="omar@thesis.local">Omar</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_commander</depend>
  <depend>control_msgs</depend>
  <depend>trajectory_msgs</depend>

  <exec_depend>mycobot_interfaces</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
