    <disable_collisions link1="front_left_steer_link" link2="gripper_right1" reason="Never"/>
    <disable_collisions link1="front_left_steer_link" link2="gripper_right2" reason="Never"/>
    <disable_collisions link1="front_left_steer_link" link2="gripper_right3" reason="Never"/>
