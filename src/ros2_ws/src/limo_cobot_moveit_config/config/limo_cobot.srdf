    <disable_collisions link1="front_left_steer_link" link2="joint5" reason="Never"/>
    <disable_collisions link1="front_left_steer_link" link2="laser_link" reason="Never"/>
    <disable_collisions link1="front_left_steer_link" link2="rear_left_wheel_link" reason="Never"/>
    <disable_collisions link1="front_left_steer_link" link2="rear_right_wheel_link" reason="Never"/>
    <disable_collisions link1="front_left_wheel_link" link2="front_right_steer_link" reason="Never"/>
    <disable_collisions link1="front_left_wheel_link" link2="front_right_wheel_link" reason="Never"/>
