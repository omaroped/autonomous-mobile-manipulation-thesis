    <disable_collisions link1="joint4" link2="rear_right_wheel_link" reason="Never"/>
    <disable_collisions link1="joint5" link2="joint6" reason="Adjacent"/>
    <disable_collisions link1="joint5" link2="joint6_flange" reason="Never"/>
    <disable_collisions link1="joint5" link2="rear_left_wheel_link" reason="Never"/>
    <disable_collisions link1="joint5" link2="rear_right_wheel_link" reason="Never"/>
    <disable_collisions link1="joint6" link2="joint6_flange" reason="Adjacent"/>
    <disable_collisions link1="laser_link" link2="rear_left_wheel_link" reason="Never"/>
    <disable_collisions link1="laser_link" link2="rear_right_wheel_link" reason="Never"/>
    <disable_collisions link1="rear_left_wheel_link" link2="rear_right_wheel_link" reason="Never"/>

    <!-- ===== FIX (restored to prevent false-positives during reach/planning) =====
         The Setup-Assistant matrix disabled the gripper FINGER links against the
         LIMO base appendages (wheels, steers, laser, camera) but MISSED the wrist
         and gripper body: joint6, joint6_flange and gripper_base. As soon as the
         waist rotated to reach forward/down, MoveIt flagged these as colliding with
         the wheels/steers/laser/camera (they pass ABOVE them, never touch) and
         refused to plan ANY Cartesian goal — the arm could only fold to waist=0.
         These end-of-arm links never contact the fixed base during a grasp, so the
         collisions are disabled here (matching how the fingers already are). -->
    <disable_collisions link1="gripper_base" link2="front_left_wheel_link"  reason="Never"/>
    <disable_collisions link1="gripper_base" link2="front_right_wheel_link" reason="Never"/>
    <disable_collisions link1="gripper_base" link2="rear_left_wheel_link"   reason="Never"/>
