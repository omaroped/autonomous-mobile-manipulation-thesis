<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="lab_world">
    <!-- Ground -->
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- Physics -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver><type>quick</type><iters>100</iters></solver>
      </ode>
    </physics>

    <!-- Outer Boundary (10m wide x 12m deep - Portrait) -->
    <!-- X: -5 to 5, Y: -6 to 6 -->
    <model name="lab_boundary">
      <static>true</static>
      <link name="link">
        <collision name="wall_n"><pose>0 6 0.5 0 0 0</pose><geometry><box><size>10 0.1 1</size></box></geometry></collision>
        <visual name="wall_n_v"><pose>0 6 0.5 0 0 0</pose><geometry><box><size>10 0.1 1</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
        
        <collision name="wall_s"><pose>0 -6 0.5 0 0 0</pose><geometry><box><size>10 0.1 1</size></box></geometry></collision>
        <visual name="wall_s_v"><pose>0 -6 0.5 0 0 0</pose><geometry><box><size>10 0.1 1</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient></material></visual>

        <collision name="wall_e"><pose>5 0 0.5 0 0 0</pose><geometry><box><size>0.1 12 1</size></box></geometry></collision>
        <visual name="wall_e_v"><pose>5 0 0.5 0 0 0</pose><geometry><box><size>0.1 12 1</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient></material></visual>

        <collision name="wall_w"><pose>-5 0 0.5 0 0 0</pose><geometry><box><size>0.1 12 1</size></box></geometry></collision>
        <visual name="wall_w_v"><pose>-5 0 0.5 0 0 0</pose><geometry><box><size>0.1 12 1</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>
    </model>

    <!-- Divider / Partition (Red) - Stick to Right Wall (East) -->
    <!-- Positioned to create a 8m vs 4m split (2/3 vs 1/3) -->
    <!-- Room total Y=12. Partition at Y=-2. -->
    <model name="divider_partition_red">
      <static>true</static>
      <!-- X: from -3 to 5 (length 8), Gap: -5 to -3 (2m) -->
      <pose>1 -2 0.05 0 0 0</pose> 
      <link name="link">
        <collision name="col"><geometry><box><size>8 0.2 0.1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>8 0.2 0.1</size></box></geometry><material><ambient>1 0 0 1</ambient></material></visual>
      </link>
    </model>

    <!-- Counter (Light Blue) - Stick to Left Wall (West) -->
    <model name="counter_light_blue">
      <static>true</static>
      <pose>-4.9 1 0.05 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 4.0 0.1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 4.0 0.1</size></box></geometry><material><ambient>0.6 0.8 1 1</ambient></material></visual>
      </link>
    </model>

    <!-- Station A Assembly (Green) - Top Right Area -->
    <model name="station_a_assembly">
      <static>true</static>
      <pose>3 4 0.05 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.0 1.0 0.1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.0 1.0 0.1</size></box></geometry><material><ambient>0 1 0 1</ambient></material></visual>
      </link>
    </model>

    <!-- Computer Table (Dark Blue) - Bottom Right Area -->
    <model name="computer_table">
      <static>true</static>
      <pose>3 -4.5 0.05 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>3.0 2.0 0.1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>3.0 2.0 0.1</size></box></geometry><material><ambient>0 0 0.8 1</ambient></material></visual>
      </link>
    </model>

    <!-- Storage (Yellow) - Bottom Left Area, Stick to South Wall -->
    <model name="storage_parts">
      <static>true</static>
      <pose>-3 -5.95 0.05 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.0 0.1 0.1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.0 0.1 0.1</size></box></geometry><material><ambient>1 1 0 1</ambient></material></visual>
      </link>
    </model>

    <!-- World Plugins -->
    <plugin name="gazebo_ros_init" filename="libgazebo_ros_init.so"/><plugin name="gazebo_ros_factory" filename="libgazebo_ros_factory.so"/>
  </world>
</sdf>
