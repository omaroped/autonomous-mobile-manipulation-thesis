<!--Company: Institut fuer Intermodale Transport und Logistiksysteme in Technische Universitaet Braunschweig -->
<!-- Description: Diese xacro-Datei basiert auf Regeln und definiert Funktionen durch xacro,
um die Erstellung der Struktur des Wagens in Ackerman-Type zu ermoeglichen. Es liegen die Karosserie des kleinen Wagens,
die Raedern und Steuerscharnier im vorderen Achse, und auch die hinten Raedern. -->

<robot name="limo_ackermann" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="drive_mode" default="diff"/>
    <xacro:property name="drive_mode" value="$(arg drive_mode)"/>

