<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <ros2_control name="MyCobotGazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <!-- Arm Joints -->
    <joint name="joint2_to_joint1">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint3_to_joint2">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint4_to_joint3">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint5_to_joint4">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint6_to_joint5">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint6output_to_joint6">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <!-- Gripper -->
    <joint name="gripper_controller">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>

    <!-- Gripper fingers: explicitly commanded (NOT mimic). Gazebo Classic's mimic
         support is unreliable, so the gripper controller drives all 6 joints
         directly; the mirror signs [1,1,-1,-1,-1,1] are baked into the command
         values (GRIPPER_OPEN/CLOSE in the nodes / teleop). Each joint is revolute
         in the adaptive-gripper URDF so Gazebo exposes these position interfaces. -->
    <joint name="gripper_base_to_gripper_left2">
      <command_interface name="position">
        <param name="min">-0.8</param>
        <param name="max">0.5</param>
      </command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="gripper_left3_to_gripper_left1">
      <command_interface name="position">
        <param name="min">-0.5</param>
        <param name="max">0.5</param>
      </command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="gripper_base_to_gripper_right3">
      <command_interface name="position">
        <param name="min">-0.15</param>
        <param name="max">0.7</param>
      </command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="gripper_base_to_gripper_right2">
      <command_interface name="position">
        <param name="min">-0.5</param>
        <param name="max">0.8</param>
      </command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="gripper_right3_to_gripper_right1">
      <command_interface name="position">
        <param name="min">-0.5</param>
        <param name="max">0.5</param>
      </command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <!-- Mecanum wheels are NOT in ros2_control: the base is driven holonomically by the
         planar_move Gazebo plugin (see ackermann.xacro); the wheels are cosmetic/fixed. -->
  </ros2_control>

  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <parameters>$(find limo_car)/config/mycobot_controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- ── Real physics grasp (added 2026-07-29) ────────────────────────────────
       Creates an ACTUAL fixed joint between the palm and the grasped object once
       enough finger contacts accumulate, and destroys it when the gripper opens
       past <release_position>.

       Replaces the kinematic weld in grasp_attacher.py, which had two defects the
       joint fixes at once:
         1. It only copied POSITION. The object's orientation was frozen at pickup,
            so the box never rotated with the hand — the dome stayed pointing up
            however the wrist turned. A fixed joint couples all 6 DOF.
         2. It teleported at ~50 Hz while Gazebo physics runs at 1000 Hz — a 20×
            mismatch, so the box drifted under gravity between updates and snapped
            back, which is the visible lag/jitter when the arm or base moves fast.
            A joint is solved inside the physics step, so there is no lag at all.

       release_position=0.0: the gripper closes toward -0.20 and opens to +0.15, so
       "joint position rose above 0.0" means the fingers have opened → let go.
       grasp_count_threshold=10 is the plugin default; lower it if grasps are missed,
       raise it if the box is grabbed on a glancing touch. -->
  <gazebo>
    <plugin filename="libgazebo_grasp_plugin.so" name="gazebo_grasp_fix">
      <!-- MUST be a link that exists in GAZEBO, not merely in the URDF.
           This was 'gripper_base' and silently broke every grasp: Gazebo's URDF->SDF
           conversion merges a link joined by a FIXED joint into its parent, so
           gripper_base is folded into joint6_flange and disappears as an addressable
           link (visible as joint6_flange_fixed_joint_lump__gripper_base_visual_1 in
           `gz model -m mbot -i`). The plugin loaded fine and counted contacts fine,
           then failed at the last step every single time:
               [Err] [gazebo_grasp_fix.cpp:195]
               [GazeboGraspFix] palm link 'gripper_base' not found on model
           AttachObject() returns there WITHOUT creating the joint, so the box was
           held by friction alone and slid out of the fingers on every lift.
           Verified 2026-07-29 against the live model, not assumed.
           The finger links below are fine — gripper_left1/left3/right1/right3 all
           survive as real links because they are joined by REVOLUTE joints. -->
      <palm_link>joint6_flange</palm_link>
      <gripper_finger_link>gripper_left1</gripper_finger_link>
      <gripper_finger_link>gripper_left3</gripper_finger_link>
      <gripper_finger_link>gripper_right1</gripper_finger_link>
      <gripper_finger_link>gripper_right3</gripper_finger_link>
      <gripper_joint>gripper_controller</gripper_joint>
      <release_position>0.0</release_position>
      <grasp_count_threshold>10</grasp_count_threshold>
    </plugin>
  </gazebo>
</robot>
