<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="lab_world">
    <!-- WORLD plugin (must be here, not loaded with gzserver -s): provides
         /get_entity_state + /set_entity_state, used by base_pin and grasp_attacher.
         Harmless to the main pipeline (just adds those services + model-state pubs). -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>50.0</update_rate>
    </plugin>
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <model name="wall_north">
      <static>true</static>
      <pose>0 9 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12 0.2 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 0.2 1</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -9 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12 0.2 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 0.2 1</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Stations: Green (Hollow Bin) -->
    <model name="green_station">
      <static>true</static>
      <pose>2.0 4.0 0.1 0 0 0</pose>
      <link name="base">
        <!-- Floor -->
        <visual name="v_floor"><pose>0 0 0 0 0 0</pose><geometry><box><size>1.0 1.0 0.02</size></box></geometry><material><ambient>0 0.8 0 1</ambient><diffuse>0 0.8 0 1</diffuse></material></visual>
        <collision name="c_floor"><pose>0 0 0 0 0 0</pose><geometry><box><size>1.0 1.0 0.02</size></box></geometry></collision>
        <!-- Wall N -->
        <visual name="v_n"><pose>0 0.49 0.1 0 0 0</pose><geometry><box><size>1.0 0.02 0.2</size></box></geometry><material><ambient>0 0.8 0 1</ambient><diffuse>0 0.8 0 1</diffuse></material></visual>
        <collision name="c_n"><pose>0 0.49 0.1 0 0 0</pose><geometry><box><size>1.0 0.02 0.2</size></box></geometry></collision>
        <!-- Wall S -->
        <visual name="v_s"><pose>0 -0.49 0.1 0 0 0</pose><geometry><box><size>1.0 0.02 0.2</size></box></geometry><material><ambient>0 0.8 0 1</ambient><diffuse>0 0.8 0 1</diffuse></material></visual>
        <collision name="c_s"><pose>0 -0.49 0.1 0 0 0</pose><geometry><box><size>1.0 0.02 0.2</size></box></geometry></collision>
        <!-- Wall E -->
        <visual name="v_e"><pose>0.49 0 0.1 0 0 0</pose><geometry><box><size>0.02 1.0 0.2</size></box></geometry><material><ambient>0 0.8 0 1</ambient><diffuse>0 0.8 0 1</diffuse></material></visual>
        <collision name="c_e"><pose>0.49 0 0.1 0 0 0</pose><geometry><box><size>0.02 1.0 0.2</size></box></geometry></collision>
        <!-- Wall W -->
        <visual name="v_w"><pose>-0.49 0 0.1 0 0 0</pose><geometry><box><size>0.02 1.0 0.2</size></box></geometry><material><ambient>0 0.8 0 1</ambient><diffuse>0 0.8 0 1</diffuse></material></visual>
        <collision name="c_w"><pose>-0.49 0 0.1 0 0 0</pose><geometry><box><size>0.02 1.0 0.2</size></box></geometry></collision>
      </link>
    </model>

    <!-- Stations: Yellow (Hollow Bin) -->
    <model name="yellow_station">
      <static>true</static>
      <pose>6.0 4.0 0.1 0 0 0</pose>
      <link name="base">
        <!-- Floor -->
        <visual name="v_floor"><pose>0 0 0 0 0 0</pose><geometry><box><size>1.0 1.0 0.02</size></box></geometry><material><ambient>0.8 0.8 0 1</ambient><diffuse>0.8 0.8 0 1</diffuse></material></visual>
        <collision name="c_floor"><pose>0 0 0 0 0 0</pose><geometry><box><size>1.0 1.0 0.02</size></box></geometry></collision>
        <!-- Wall N -->
        <visual name="v_n"><pose>0 0.49 0.1 0 0 0</pose><geometry><box><size>1.0 0.02 0.2</size></box></geometry><material><ambient>0.8 0.8 0 1</ambient><diffuse>0.8 0.8 0 1</diffuse></material></visual>
        <collision name="c_n"><pose>0 0.49 0.1 0 0 0</pose><geometry><box><size>1.0 0.02 0.2</size></box></geometry></collision>
        <!-- Wall S -->
        <visual name="v_s"><pose>0 -0.49 0.1 0 0 0</pose><geometry><box><size>1.0 0.02 0.2</size></box></geometry><material><ambient>0.8 0.8 0 1</ambient><diffuse>0.8 0.8 0 1</diffuse></material></visual>
        <collision name="c_s"><pose>0 -0.49 0.1 0 0 0</pose><geometry><box><size>1.0 0.02 0.2</size></box></geometry></collision>
        <!-- Wall E -->
        <visual name="v_e"><pose>0.49 0 0.1 0 0 0</pose><geometry><box><size>0.02 1.0 0.2</size></box></geometry><material><ambient>0.8 0.8 0 1</ambient><diffuse>0.8 0.8 0 1</diffuse></material></visual>
        <collision name="c_e"><pose>0.49 0 0.1 0 0 0</pose><geometry><box><size>0.02 1.0 0.2</size></box></geometry></collision>
        <!-- Wall W -->
        <visual name="v_w"><pose>-0.49 0 0.1 0 0 0</pose><geometry><box><size>0.02 1.0 0.2</size></box></geometry><material><ambient>0.8 0.8 0 1</ambient><diffuse>0.8 0.8 0 1</diffuse></material></visual>
        <collision name="c_w"><pose>-0.49 0 0.1 0 0 0</pose><geometry><box><size>0.02 1.0 0.2</size></box></geometry></collision>
      </link>
    </model>

    
    <model name="wall_east">
      <static>true</static>
      <pose>6 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 18 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 18 1</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-6 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 18 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 18 1</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="divider_partition_red">
      <static>true</static>
      <pose>2 1 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8 0.1 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 0.1 1</size></box></geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>0.8 0 0 1</diffuse>
            <specular>0.1 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="station_a_assembly">
      <static>true</static>
      <pose>-5.0 7.5 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 0.8 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.8 0.2</size></box></geometry>
          <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 0.8 0 1</diffuse>
            <specular>0 0.1 0 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="storage_parts">
      <static>true</static>
      <pose>4.8 -5 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.2</size></box></geometry>
          <material>
            <ambient>1 1 0 1</ambient>
            <diffuse>0.8 0.8 0 1</diffuse>
            <specular>0.1 0.1 0 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="counter_light_blue">
      <static>true</static>
      <pose>1 -6.5 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4 0.2 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4 0.2 0.2</size></box></geometry>
          <material>
            <ambient>0.6 0.8 1 1</ambient>
            <diffuse>0.6 0.8 1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <!-- Pickup table: 30x15cm, 10cm tall. Narrow in Y so robot front clears it at 0.17m stop. -->
    <model name='pickup_table'>
      <static>1</static>
      <pose>-2 4 0.05 0 0 0</pose>
      <link name='link'>
        <collision name='col'>
          <geometry><box><size>0.3 0.08 0.1</size></box></geometry>
        </collision>
        <visual name='vis'>
          <geometry><box><size>0.3 0.08 0.1</size></box></geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>
        <self_collide>0</self_collide>
      </link>
    </model>

    <!-- Place table: 0.18×0.18×0.10 m square, neutral grey.
         Reachable from any of 4 sides (arm reach 0.24-0.28 m > half-side 0.09 m).
         AprilTag 36h11 face plates (ID 0-3) on each vertical face for fiducial docking.
         Tag plates are 0.001 m thin so they don't affect collision geometry.
         Table top at z=0.10; tag centres at z=0.075 (mid-face height). -->
    <model name='place_table'>
      <static>1</static>
      <pose>-4 -2 0 0 0 0</pose>
      <!-- Main body -->
      <link name='body'>
        <pose>0 0 0.05 0 0 0</pose>
        <collision name='col'>
          <geometry><box><size>0.18 0.18 0.10</size></box></geometry>
        </collision>
        <visual name='vis'>
          <geometry><box><size>0.18 0.18 0.10</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <self_collide>0</self_collide>
      </link>
      <!-- Tag face plates — thin visual-only panels on each vertical face.
           Pose is relative to model origin (floor level, table centre).
           Face normal outward (+Y = north, -Y = south, +X = east, -X = west).
           Tag ID 0: North face (+Y, yaw=0) -->
      <link name='tag_north'>
        <pose>0 0.091 0.075 0 0 0</pose>
        <visual name='vis'>
          <geometry><box><size>0.10 0.001 0.10</size></box></geometry>
          <material>
            <script>
              <uri>model://limo_car/media/materials/scripts/apriltag.material</uri>
              <uri>model://limo_car/media/materials/textures/</uri>
              <name>AprilTag_0</name>
            </script>
          </material>
        </visual>
        <self_collide>0</self_collide>
      </link>
      <!-- Tag ID 1: South face (-Y, yaw=π) -->
      <link name='tag_south'>
        <pose>0 -0.091 0.075 0 0 3.14159</pose>
        <visual name='vis'>
          <geometry><box><size>0.10 0.001 0.10</size></box></geometry>
          <material>
            <script>
              <uri>model://limo_car/media/materials/scripts/apriltag.material</uri>
              <uri>model://limo_car/media/materials/textures/</uri>
              <name>AprilTag_1</name>
            </script>
          </material>
        </visual>
        <self_collide>0</self_collide>
      </link>
      <!-- Tag ID 2: East face (+X, yaw=-π/2) -->
      <link name='tag_east'>
        <pose>0.091 0 0.075 0 0 -1.5708</pose>
        <visual name='vis'>
          <geometry><box><size>0.10 0.001 0.10</size></box></geometry>
          <material>
            <script>
              <uri>model://limo_car/media/materials/scripts/apriltag.material</uri>
              <uri>model://limo_car/media/materials/textures/</uri>
              <name>AprilTag_2</name>
            </script>
          </material>
        </visual>
        <self_collide>0</self_collide>
      </link>
      <!-- Tag ID 3: West face (-X, yaw=+π/2) -->
      <link name='tag_west'>
        <pose>-0.091 0 0.075 0 0 1.5708</pose>
        <visual name='vis'>
          <geometry><box><size>0.10 0.001 0.10</size></box></geometry>
          <material>
            <script>
              <uri>model://limo_car/media/materials/scripts/apriltag.material</uri>
              <uri>model://limo_car/media/materials/textures/</uri>
              <name>AprilTag_3</name>
            </script>
          </material>
        </visual>
        <self_collide>0</self_collide>
      </link>
    </model>

    <!-- Blue self-centering stack boxes: 3 distinct dynamic boxes on the pickup table.
         Body 35x35x40mm (unchanged footprint — same grasp geometry as before).
         Each box has a convex dome on top (R=10mm, H=5mm) and a concave cavity on
         the bottom (R=11mm, H=6mm, i.e. 1mm larger in radius AND depth) generated by
         scripts/gen_stack_box.py → meshes/stack_box.stl. When one box is placed on
         another, the lower box's dome seats into the upper box's cavity — the 1mm
         tolerance band makes the stack self-centering even with a few mm of arm
         placement error. Table top z=0.10, box half-height=0.02 → centre z=0.12.
         Spaced 0.08 m apart along the table's long (X) axis — the table is only
         0.08 m wide in Y, so boxes sit end-to-end along its 0.30 m length, each a
         separate blue blob for perception. Mass/inertia reuse the plain-box values
         (dome/cavity are a small volume perturbation near the central axis — fine
         for sim dynamics, not a precision inertia calc).
         Same tuned friction/contact ODE params as before (soft contact prevents
         jitter/tunnelling on the table surface). -->
    <!-- REGRESSION TEST 2026-07-28 — collision reverted to a PRIMITIVE box.
         The pipeline completed successfully end-to-end on 2026-07-02 (see
         data/metrics_20260702_003437.csv and _232206.csv: pick/transport/dock/place
         all True) with a primitive-collision box 0.035x0.035x0.04 at pose -2.00 4 0.12.
         It then failed 17 consecutive runs after the 3-box self-centering redesign
         swapped the collision to the triangle mesh stack_box.stl at -2.08 4 0.12.
         Triangle-mesh collision on a small, light, grasped object is a known ODE
         instability source and matches the observed "box launches / drops on lift".
         The mesh BODY is 0.035x0.035x0.040 (gen_stack_box.py) — identical to the
         primitive — so BOX_HALF_H / BOX_HEIGHT in the orchestrator stay valid.
         The mesh is kept for VISUAL only, so the box still looks the same.
         If this restores success, the mesh collision was the regression. -->
    <model name='stack_box_0'>
      <pose>-2.00 4 0.12 0 0 0</pose>
      <link name='link'>
        <inertial>
          <mass>0.04</mass>
          <inertia>
            <ixx>9.42e-6</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>9.42e-6</iyy><iyz>0</iyz>
            <izz>8.17e-6</izz>
          </inertia>
        </inertial>
        <collision name='col'>
          <!-- PRIMITIVE, exactly as in the last known-working commit 08e8af4.
               Contact params below are byte-identical to that version, so the
               collision SHAPE is the only remaining difference. -->
          <geometry><box><size>0.035 0.035 0.04</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
            <contact>
              <ode>
                <kp>1e6</kp>
                <kd>1.0</kd>
                <max_vel>0.01</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name='vis'>
          <geometry><mesh><uri>model://limo_car/meshes/stack_box.stl</uri><scale>1 1 1</scale></mesh></geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0.2 1 1</diffuse>
          </material>
        </visual>
        <self_collide>0</self_collide>
      </link>
    </model>

    <!-- stack_box_1 and stack_box_2 removed — single-box testing for now. Re-add
         them (and revert _remaining_boxes in nav_pick_orchestrator.py) once
         one-box grasping is reliable. -->

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-5.0 7.0 6.0 0 0.8 -1.57</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>
