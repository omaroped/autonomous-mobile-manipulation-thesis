<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <!-- Ground -->
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <!-- Light -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Physics Engine Settings -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- World Plugins for ROS 2 -->
    <plugin name="gazebo_ros_init" filename="libgazebo_ros_init.so">
      <ros>
        <!-- <node_name>gazebo_ros_init</node_name> -->
      </ros>
    </plugin>
    <plugin name="gazebo_ros_factory" filename="libgazebo_ros_factory.so">
      <ros>
        <!-- <node_name>gazebo_ros_factory</node_name> -->
      </ros>
    </plugin>

    <!-- Walls -->
    <model name="room">
      <static>true</static>
      <link name="link">
        <collision name="wall1">
          <pose>5 0 0.5 0 0 0</pose>
          <geometry><box><size>0.1 10 1</size></box></geometry>
        </collision>
        <visual name="wall1_v">
          <pose>5 0 0.5 0 0 0</pose>
          <geometry><box><size>0.1 10 1</size></box></geometry>
        </visual>
        
        <collision name="wall2">
          <pose>-5 0 0.5 0 0 0</pose>
          <geometry><box><size>0.1 10 1</size></box></geometry>
        </collision>
        <visual name="wall2_v">
          <pose>-5 0 0.5 0 0 0</pose>
          <geometry><box><size>0.1 10 1</size></box></geometry>
        </visual>

        <collision name="wall3">
          <pose>0 5 0.5 0 0 0</pose>
          <geometry><box><size>10 0.1 1</size></box></geometry>
        </collision>
        <visual name="wall3_v">
          <pose>0 5 0.5 0 0 0</pose>
          <geometry><box><size>10 0.1 1</size></box></geometry>
        </visual>

        <collision name="wall4">
          <pose>0 -5 0.5 0 0 0</pose>
          <geometry><box><size>10 0.1 1</size></box></geometry>
        </collision>
        <visual name="wall4_v">
          <pose>0 -5 0.5 0 0 0</pose>
          <geometry><box><size>10 0.1 1</size></box></geometry>
        </visual>
      </link>
    </model>

  </world>
</sdf>
