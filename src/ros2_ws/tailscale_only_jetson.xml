<?xml version="1.0" encoding="UTF-8"?>
<!-- Same as tailscale_only_laptop.xml, for the JETSON side -- only the whitelisted
     address differs (this machine's own Tailscale IP). See that file for the full
     explanation. Usage: export FASTRTPS_DEFAULT_PROFILES_FILE=<path to this file>,
     before launching any ROS2 process on the Jetson. -->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <profiles>
        <transport_descriptors>
            <transport_descriptor>
                <transport_id>udp_tailscale</transport_id>
                <type>UDPv4</type>
                <interfaceWhiteList>
                    <address>100.106.125.32</address>
                </interfaceWhiteList>
            </transport_descriptor>
        </transport_descriptors>

        <participant profile_name="tailscale_only" is_default_profile="true">
            <rtps>
                <userTransports>
                    <transport_id>udp_tailscale</transport_id>
                </userTransports>
                <useBuiltinTransports>false</useBuiltinTransports>
            </rtps>
        </participant>
    </profiles>
</dds>
