// The universal robotics loop, mapped to our nodes.
// Render:  dot -Tsvg pipeline.dot -o pipeline.svg
digraph pipeline {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=12, labelloc=t,
         label="The robotics loop  (Sense → Locate → Plan → Act → repeat)"];
  node  [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled"];
  edge  [fontname="Helvetica", fontsize=9, color="#555555"];

  sense  [label="SENSE\ncamera, LiDAR\n(gzserver)", fillcolor="#bcdcff", color="#4a90d9"];
  locate [label="LOCATE\nbox_pose_estimator /\nbox_follower", fillcolor="#c9eec9", color="#4caf50"];
  plan   [label="PLAN\nMoveIt (arm) /\nNav2 (base)", fillcolor="#e4cffb", color="#9b59b6"];
  act    [label="ACT\nros2_control /\n/cmd_vel", fillcolor="#ffe1b3", color="#ef9a3a"];

  sense -> locate -> plan -> act;
  act -> sense [label="the world changed", style=dashed, constraint=false];
}
