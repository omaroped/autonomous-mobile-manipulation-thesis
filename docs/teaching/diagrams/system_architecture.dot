// System data-flow: nodes (boxes) connected by ROS 2 topics/actions (edges).
// Render:  dot -Tsvg system_architecture.dot -o system_architecture.svg
digraph system {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=12, labelloc=t,
         label="LIMO + myCobot — ROS 2 Data Flow  (boxes = nodes, arrows = topics/actions)"];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", color="#444444"];
  edge  [fontname="Helvetica", fontsize=8, color="#666666"];

  subgraph cluster_gazebo {
    label="GAZEBO (gzserver) — physics, sensors, ros2_control";
    style="rounded,filled"; fillcolor="#eef6ff"; color="#4a90d9"; fontname="Helvetica-Bold";
    gazebo [label="gzserver\n(the simulation)", fillcolor="#bcdcff"];
    jsb    [label="joint_state_broadcaster", fillcolor="#dcecfe"];
    armc   [label="mycobot_arm_controller\n(JointTrajectory)", fillcolor="#dcecfe"];
    gripc  [label="mycobot_gripper_controller\n(position)", fillcolor="#dcecfe"];
  }
  subgraph cluster_perc {
    label="PERCEPTION"; style="rounded,filled"; fillcolor="#eafbea"; color="#4caf50"; fontname="Helvetica-Bold";
    perc [label="box_pose_estimator\nHSV + depth → 3D → TF", fillcolor="#c9eec9"];
  }
  subgraph cluster_brain {
    label="BRAIN (orchestration)"; style="rounded,filled"; fillcolor="#fff4e3"; color="#ef9a3a"; fontname="Helvetica-Bold";
    brain [label="pick_orchestrator\n/ arm_grasp_test", fillcolor="#ffe1b3"];
  }
  subgraph cluster_moveit {
    label="MoveIt 2"; style="rounded,filled"; fillcolor="#f4e9ff"; color="#9b59b6"; fontname="Helvetica-Bold";
    moveit [label="move_group\nIK (KDL) + OMPL + planning scene", fillcolor="#e4cffb"];
  }

  // sensing
  gazebo -> perc  [label="/rgb/image_raw\n/depth/image_raw\n/camera_info"];
  perc   -> brain [label="/box_pose", color="#2e8b2e", penwidth=1.6];
  jsb    -> moveit[label="/joint_states\n(where the arm IS)", color="#2e6da4", penwidth=1.6];

  // commanding
  brain  -> moveit[label="/move_action  (goal: go to pose)", color="#9b59b6", penwidth=1.6];
  moveit -> armc  [label="joint trajectory (action)", color="#9b59b6"];
  brain  -> gripc [label="/mycobot_gripper_controller/commands", color="#ef9a3a"];

  // actuation back into the sim
  armc  -> gazebo [label="drive arm joints", style=dashed];
  gripc -> gazebo [label="drive gripper", style=dashed];
  jsb   -> gazebo [style=invis];
}
