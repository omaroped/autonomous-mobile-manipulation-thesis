# ============================
# Thesis Project .gitignore
# ============================

# ----- OS files -----
.DS_Store
Thumbs.db
Desktop.ini

# ----- IDE / Editor -----
.vscode/
.idea/
*.swp
*.swo
*~

# ----- Python -----
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# ----- ROS 2 build artifacts -----
build/
install/
log/

# ----- Local Only Directories (Excluded from GitHub) -----
docs/
data/
archive/
experiments/
third_party/
LIMO_PRO_REFERENCE.md

# ----- Simulation artifacts -----
simulation/**/*.log

# ----- Misc -----
*.bag
*.db3
*.mcap
