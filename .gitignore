# ============================
# Thesis Project .gitignore
# ============================

# ----- OS files -----
.DS_Store
Thumbs.db
Desktop.ini

# ----- IDE / Editor -----
.vscode/
.idea/
*.swp
*.swo
*~

# ----- Python -----
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# ----- ROS 2 build artifacts -----
src/ros2_ws/build/
src/ros2_ws/install/
src/ros2_ws/log/

# ----- Data (large files) -----
data/raw/
data/processed/
!data/raw/.gitkeep
!data/processed/.gitkeep

# ----- Papers (copyright) -----
references/papers/*.pdf
!references/papers/.gitkeep

# ----- LaTeX build artifacts -----
docs/thesis/*.aux
docs/thesis/*.log
docs/thesis/*.out
docs/thesis/*.toc
docs/thesis/*.lof
docs/thesis/*.lot
docs/thesis/*.bbl
docs/thesis/*.blg
docs/thesis/*.fls
docs/thesis/*.fdb_latexmk
docs/thesis/*.synctex.gz
docs/thesis/*.pdf

# ----- Media (large files — track with Git LFS if needed) -----
media/videos/*.mp4
media/videos/*.avi
media/videos/*.mkv
!media/videos/.gitkeep

# ----- Simulation artifacts -----
simulation/**/*.log

# ----- Misc -----
*.bag
*.db3
*.mcap

# ============================
# Cleanup 2026-06-19 (workspace tidy)
# ============================

# ----- Root-level colcon artifacts (in case colcon is ever run from root) -----
/build/
/install/
/log/

# ----- All backup files -----
*.bak

# ----- Node / web build artifacts (course website) -----
node_modules/

# ----- CV LaTeX build artifacts (keep cv.tex + cv.pdf) -----
cv/*.aux
cv/*.log
cv/*.out
cv/*.toc
cv/*.synctex.gz

# ----- Archived / backup project trees (kept on disk, not tracked) -----
_archive/
backup_before_collision_fix/

# ----- Separate sibling projects embedded in this tree (own git repos) -----
smart-manufacturing-nav/
my-ai-project/

# ============================
# Cleanup 2026-06-23
# ============================

# ----- External ROS packages (have their own upstream git repos — not our code) -----
src/ros2_ws/src/mycobot_ros2/
src/ros2_ws/src/gazebo_ros2_control/

# ----- ROS bag WAL/SHM sidecar files -----
*.db3-wal
*.db3-shm

# ----- ROS bag recording directories -----
data/limo_manual_run1/
src/ros2_ws/limo_manual_run1/
src/ros2_ws/limo_real_run2/

# ----- ROS workspace build/test logs -----
src/ros2_ws/build_out.txt
src/ros2_ws/build_err.txt
src/ros2_ws/build_stdout.txt
src/ros2_ws/build_stderr.txt
src/ros2_ws/mec_smoke.log

# ----- AI agent / tool artifacts -----
src/ros2_ws/.agents/
src/ros2_ws/.antigravitycli/
.claude/
sync_memory.sh

# ----- Obsidian editor config -----
docs/.obsidian/

# ----- AI-generated prompt/memory artifacts (not thesis content) -----
docs/super_memory/
docs/SUPER_MEMORY_PROMPT.md
docs/SUPER_MEMORY_PROMPT_v2_EXTENSION.md
CLEANUP_REPORT.md
docs/REORG_REPORT.md

# ----- Proposal (kept local only — not published to GitHub) -----
docs/proposal/
